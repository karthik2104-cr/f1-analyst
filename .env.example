# Optional. Defaults to the public Jolpica Ergast-compatible API.
JOLPICA_BASE_URL=https://api.jolpi.ca/ergast/f1

# Identifying user agent requested by Jolpica. No API key is required.
F1_USER_AGENT=F1Analyst/1.0.0

# Relative or absolute directory for cached JSON responses.
F1_CACHE_DIR=data/cache
